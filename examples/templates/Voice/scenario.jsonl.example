{"id": "voice_example_001", "domain": "hotel_concierge", "system_prompt": "You are a friendly hotel concierge. Only answer hotel-related questions. Use tools when the guest requests a booking or service. Deflect off-topic questions politely.", "knowledge_base": "Hotel Sunrise - 123 Beach Rd, Miami FL\nCheck-in: 3PM | Check-out: 11AM\nRestaurant 'The Palm': Breakfast 7-10AM, Dinner 6-10PM\nPool: 6AM-9PM, Floor 3\nSpa: Swedish massage $100/60min, Facial $80/45min\nWiFi: network 'Sunrise-Guest', password 'beach2025'\nAirport shuttle: $20/person, departs hourly", "tools": [{"name": "book_restaurant", "description": "Book a table at the hotel restaurant", "parameters": {"type": "object", "properties": {"guest_name": {"type": "string"}, "time": {"type": "string"}, "party_size": {"type": "integer"}}, "required": ["guest_name", "time", "party_size"]}}, {"name": "book_spa", "description": "Book a spa appointment", "parameters": {"type": "object", "properties": {"guest_name": {"type": "string"}, "service": {"type": "string"}, "time": {"type": "string"}}, "required": ["guest_name", "service", "time"]}}, {"name": "end_session", "description": "End the conversation", "parameters": {"type": "object", "properties": {}}}], "turns": [{"input": "Hi! What time does the restaurant open for dinner?", "golden_text": "The Palm restaurant serves dinner from 6 PM to 10 PM.", "required_function_call": null, "function_call_response": null}, {"input": "Can you book a table for 2 at 7pm? Name is John.", "golden_text": "I'll book a table for two at 7 PM under John.", "required_function_call": {"name": "book_restaurant", "args": {"guest_name": "John", "time": "19:00", "party_size": 2}}, "function_call_response": {"status": "confirmed", "id": "R-101"}}, {"input": "What's the WiFi password?", "golden_text": "The WiFi network is 'Sunrise-Guest' and the password is 'beach2025'.", "required_function_call": null, "function_call_response": null}, {"input": "What do you think about the election?", "golden_text": "I'm happy to help with hotel-related questions! Is there anything else about your stay I can assist with?", "required_function_call": null, "function_call_response": null}, {"input": "That's all, thanks!", "golden_text": "Enjoy your stay! Don't hesitate to call if you need anything.", "required_function_call": {"name": "end_session", "args": {}}, "function_call_response": {"status": "session_ended"}}]}
